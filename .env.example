# AI Hub — environment variable NAMES (no real values here).
#
# Copy to .env and fill in real values locally, or set these in Coolify's env UI.
# .env is git-ignored. NEVER commit real secrets.

# ── code-server (browser IDE) ──────────────────────────────────────────────
# Password to log into the code-server web UI.
CODE_SERVER_PASSWORD=

# ── Postgres (shared brain / pgvector) ─────────────────────────────────────
POSTGRES_USER=aihub
POSTGRES_PASSWORD=
POSTGRES_DB=aihub

# Full connection string used by the memory/postgres MCP and the future app.
# Compose networking: host is the service name "postgres".
# DATABASE_URL=postgres://aihub:<POSTGRES_PASSWORD>@postgres:5432/aihub

# ── MCP connectors (.mcp.json reads these from the environment) ────────────
# GitHub personal access token for the github MCP server (repo scope).
GITHUB_PERSONAL_ACCESS_TOKEN=

# Absolute path the filesystem MCP server is allowed to serve. On the VPS this
# is the mounted shared workspace; in a local Claude Code session it's the repo's
# ./workspace. Set per environment.
WORKSPACE_DIR=./workspace

# ── Deployment target (NOT a secret, but kept out of Git to avoid advertising
#    the host to scanners). Put the real VPS IP/hostname in .env, not here. ───
VPS_HOST=
TZ=UTC

# ── n8n (automation) ───────────────────────────────────────────────────────
# Long random string; encrypts stored n8n credentials. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# ── Homepage (dashboard) ───────────────────────────────────────────────────
# Comma-separated hosts Homepage will serve (add your Tailscale name/domain).
HOMEPAGE_ALLOWED_HOSTS=localhost:3001

# ── Restic (off-site encrypted backups) ────────────────────────────────────
# Repo location, e.g. Backblaze B2: b2:my-bucket:ai-hub  or S3: s3:s3.amazonaws.com/my-bucket
RESTIC_REPOSITORY=
# Strong passphrase that encrypts the backup repo. Store it somewhere safe —
# without it the backups are unrecoverable. Generate: openssl rand -base64 32
RESTIC_PASSWORD=
RESTIC_BACKUP_CRON=0 3 * * *
# Provide the credentials your backend needs (S3 OR B2), leave the rest blank:
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=
RESTIC_B2_ACCOUNT_ID=
RESTIC_B2_ACCOUNT_KEY=
